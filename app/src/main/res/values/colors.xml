<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 1. Màu căn bản bắt buộc phải có -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- 2. Bảng màu chuyên nghiệp (Material 3) -->
    <color name="primary">#386B1D</color> <!-- Xanh lá đậm -->
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#B9F396</color> <!-- Xanh lá nhạt -->

    <color name="secondary">#57624A</color>
    <color name="secondary_container">#DBE7C8</color>

    <color name="background">#FDFDF6</color>
    <color name="surface">#FDFDF6</color>
    <color name="on_surface">#1A1C18</color>
    <color name="outline">#74796D</color>

    <!-- 3. ĐỊNH NGHĨA LẠI CÁC MÀU CŨ ĐỂ KHÔNG BỊ LỖI (Ánh xạ về màu mới) -->

    <!-- Ánh xạ các màu cũ về tông Xanh chủ đạo để app đồng nhất -->
    <color name="my_light_primary">@color/primary_container</color>
    <color name="my_dark_primary">@color/primary</color>
    <color name="green">@color/primary</color>

    <!-- Màu xanh có độ trong suốt (Green Trans) -->
    <color name="green_trans">#4D386B1D</color> <!-- 30% độ trong suốt của màu primary -->

</resources>

